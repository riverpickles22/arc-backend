# Required for POST /api/chat. GET /api/canon works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Where arc-core is checked out.
# ARC_CORE_PATH=../arc-core

# The story to serve. Defaults to arc-core's worked example, so this runs
# out of the box — point it at your own story when you have one.
# ARC_STORY_PATH=../my-story

# Python with pyyaml + jsonschema. Defaults to arc-core's .venv, else python3.
# ARC_PYTHON=../arc-core/.venv/bin/python

# ARC_MODEL=claude-opus-5
# PORT=8787

# Lock down CORS if you serve the frontend from a known origin.
# ARC_CORS_ORIGIN=http://localhost:5173
